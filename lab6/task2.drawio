<mxfile host="app.diagrams.net">
  <diagram name="Лабораторна - Сума і добуток (Варіант 14)">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="start2" value="Початок" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="40" width="120" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="in2" value="Введення n" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f1" edge="1" parent="1" source="start2" target="in2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="init2" value="sum = 0.0, product = 1.0&#10;k = 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f2" edge="1" parent="1" source="in2" target="init2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="cond2" value="k &lt;= n ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="280" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3" edge="1" parent="1" source="init2" target="cond2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="proc2" value="term = (1 + cos(2k)) / 2^k&#10;sum += term, product *= term" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="390" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="Так" edge="1" parent="1" source="cond2" target="proc2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="step2" value="k = k + 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f5" edge="1" parent="1" source="proc2" target="step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="f6" edge="1" parent="1" source="step2" target="cond2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="240" y="505" />
              <mxPoint x="240" y="320" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="out2" value="Вивід sum, product" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="295" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f7" value="Ні" edge="1" parent="1" source="cond2" target="out2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="end2" value="Кінець" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="f8" edge="1" parent="1" source="out2" target="end2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>