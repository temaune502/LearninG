<mxfile host="app.diagrams.net">
  <diagram name="Лабораторна - Табуляція (Варіант 14)">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <mxCell id="start1" value="Початок" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="40" width="120" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="init1" value="a = 3.5, b = 6.4, w = 6.8&#10;end = 20.0, step = 1.6" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="start1" target="init1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="cond1" value="w &lt;= 20.0 ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="init1" target="cond1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="proc1" value="y = (w^(a/b) - cbrt((w + b) / a)) / (1.1 + cos^2(a * w))" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="310" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Так" edge="1" parent="1" source="cond1" target="proc1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="out1" value="Вивід w, y" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="proc1" target="out1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="step1" value="w = w + 1.6" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="out1" target="step1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="e6" edge="1" parent="1" source="step1" target="cond1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="220" y="505" />
              <mxPoint x="220" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="end1" value="Кінець" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="215" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Ні" edge="1" parent="1" source="cond1" target="end1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>