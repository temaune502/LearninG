<mxfile host="app.diagrams.net">
  <diagram name="Лабораторна 4 - Варіант 5">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Початок -->
        <mxCell id="start" value="Початок" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="40" width="120" height="50" as="geometry" />
        </mxCell>
        
        <!-- Введення -->
        <mxCell id="input_x" value="Введення x" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="input_x" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- ДОЗ -->
        <mxCell id="dec_domain" value="x &lt; -5 або x &gt; 5 ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="input_x" target="dec_domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Вивід помилки ДОЗ -->
        <mxCell id="out_err_domain" value="Вивід: &quot;x поза межами [-5; 5]&quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="215" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Так" edge="1" parent="1" source="dec_domain" target="out_err_domain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Умова 1 -->
        <mxCell id="dec_cond1" value="|x| &lt; 2 ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="Ні" edge="1" parent="1" source="dec_domain" target="dec_cond1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Обчислення 1 -->
        <mxCell id="proc_y1" value="y = 2*x² + 3*sin(π*x/4)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="325" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="Так" edge="1" parent="1" source="dec_cond1" target="proc_y1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Умова 2 -->
        <mxCell id="dec_cond2" value="2 &lt;= |x| &lt;= 3 ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="Ні" edge="1" parent="1" source="dec_cond1" target="dec_cond2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Обчислення 2 -->
        <mxCell id="proc_y2" value="y = 11" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="435" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="Так" edge="1" parent="1" source="dec_cond2" target="proc_y2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Умова 3 -->
        <mxCell id="dec_cond3" value="3 &lt; x &lt; 4 ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="530" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="Ні" edge="1" parent="1" source="dec_cond2" target="dec_cond3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Обчислення 3 -->
        <mxCell id="proc_y3" value="y = 17 - 2*x" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="545" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="Так" edge="1" parent="1" source="dec_cond3" target="proc_y3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Умова 4 -->
        <mxCell id="dec_cond4" value="x &gt;= 4 ?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="640" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e10" value="Ні" edge="1" parent="1" source="dec_cond3" target="dec_cond4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Обчислення 4 -->
        <mxCell id="proc_y4" value="y = 2.5 * x" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="655" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e11" value="Так" edge="1" parent="1" source="dec_cond4" target="proc_y4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Невизначений проміжок -->
        <mxCell id="out_err_neg" value="Вивід: &quot;Невизначено для x ∈ [-5; -3)&quot;" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="655" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e12" value="Ні" edge="1" parent="1" source="dec_cond4" target="out_err_neg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Вивід y -->
        <mxCell id="out_y" value="Вивід y" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="760" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e13" edge="1" parent="1" source="proc_y1" target="out_y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" edge="1" parent="1" source="proc_y2" target="out_y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" edge="1" parent="1" source="proc_y3" target="out_y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" edge="1" parent="1" source="proc_y4" target="out_y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Кінець -->
        <mxCell id="end" value="Кінець" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="860" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e17" edge="1" parent="1" source="out_y" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" edge="1" parent="1" source="out_err_domain" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="240" />
              <mxPoint x="790" y="885" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e19" edge="1" parent="1" source="out_err_neg" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="680" />
              <mxPoint x="40" y="885" />
            </Array>
          </mxGeometry>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>